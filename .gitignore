# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments (root-level only — does NOT ignore ew_smart_scan/env/)
/.venv/
/venv/
/env/

# Testing / coverage
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Real TSRD dataset files — large and gated; download separately (see data/README.md)
data/tsrd_sample/
data/train/
data/validation/
data/test/
data/scan/
data/stare/
data/archive/
data/.cache/
# Preserve placeholders
!data/.gitkeep
!data/README.md

# Secrets — NEVER commit real tokens or credentials
data/.env
*.env
.env

# Generated plots (reproducible via scripts/generate_figures.py)
results/figures/*.png
results/figures/*.pdf
!results/figures/.gitkeep

# Keep headline numbers (source of truth for paper)
!results/headline_numbers.json

# HuggingFace download cache
.cache/

# OS-generated
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.idea/
*.iml
.vscode/settings.json.bak

# Kiro internal specs (not needed to run the project)
.kiro/

# Logs
*.log
logs/
